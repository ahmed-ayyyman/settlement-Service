{
  "realm": "mcdr",
  "enabled": true,
  "accessTokenLifespan": 86400,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400,
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "loginTheme": "keycloak",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "roles": {
    "realm": [
      {
        "name": "owner",
        "description": "Company owner role",
        "composite": false,
        "clientRole": false,
        "containerId": "mcdr"
      },
      {
        "name": "backoffice_employee",
        "description": "Backoffice employee role",
        "composite": false,
        "clientRole": false,
        "containerId": "mcdr"
      }
    ]
  },
  "clients": [
    {
      "clientId": "mcdr-api",
      "enabled": true,
      "publicClient": false,
      "secret": "secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "bearerOnly": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "mcdr-owner-portal",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "account-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mcdr-backoffice-portal",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:5174/*"],
      "webOrigins": ["http://localhost:5174"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "account-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "owner1",
      "email": "owner1@test.com",
      "firstName": "Owner",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "test123", "temporary": false }
      ],
      "realmRoles": ["owner"]
    },
    {
      "username": "owner2",
      "email": "owner2@test.com",
      "firstName": "Owner",
      "lastName": "Two",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "test123", "temporary": false }
      ],
      "realmRoles": ["owner"]
    },
    {
      "username": "backoffice1",
      "email": "backoffice1@test.com",
      "firstName": "Backoffice",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "test123", "temporary": false }
      ],
      "realmRoles": ["backoffice_employee"]
    },
    {
      "username": "backoffice2",
      "email": "backoffice2@test.com",
      "firstName": "Backoffice",
      "lastName": "Two",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "test123", "temporary": false }
      ],
      "realmRoles": ["backoffice_employee"]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "mcdr-api",
        "roles": ["create-user", "manage-users"]
      }
    ]
  }
}
